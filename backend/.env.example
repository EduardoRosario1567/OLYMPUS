# Copie para .env e ajuste. O backend lê essas variáveis via os.environ —
# use algo como python-dotenv ou exporte manualmente antes de subir o uvicorn.

# Obrigatória: sem ela o login sempre falha (ver app/core/security.py)
OLYMPUS_ADMIN_EMAIL=admin@olympus.local
OLYMPUS_ADMIN_SENHA=troque-isto

# Assinatura do JWT — troque em produção
OLYMPUS_JWT_SECRET=dev-secret-troque-em-producao

# sqlite (default, único validado de verdade) ou postgres (TODO em app/core/deps.py)
OLYMPUS_DB_BACKEND=sqlite
OLYMPUS_SQLITE_PATH=olympus_dev.db

# Origem(ns) permitida(s) pro frontend — separadas por vírgula
OLYMPUS_CORS_ORIGINS=http://localhost:3000
