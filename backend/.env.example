# Copie para .env e ajuste. O backend lê essas variáveis via os.environ —
# use algo como python-dotenv ou exporte manualmente antes de subir o uvicorn.

# Preenchidas pelo cadastro seguro na primeira abertura.
OLYMPUS_ADMIN_EMAIL=
OLYMPUS_ADMIN_SENHA=

# Gerada aleatoriamente e individualmente para este Mac na primeira abertura.
OLYMPUS_JWT_SECRET=

# sqlite (default, único validado de verdade) ou postgres (TODO em app/core/deps.py)
OLYMPUS_DB_BACKEND=sqlite
OLYMPUS_SQLITE_PATH=olympus_dev.db

# Origem(ns) permitida(s) pro frontend — separadas por vírgula
OLYMPUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Produção ativa verificações fail-closed de JWT, senha administrativa e CORS.
# OLYMPUS_ENV=production

# A API antiga usa um banco global de desenvolvimento e fica desligada por
# padrão. Ative apenas para diagnóstico local de versões anteriores.
# OLYMPUS_ENABLE_LEGACY_API=1

# Diretório transacional de projetos, organizações, auditoria e runtime.
OLYMPUS_CLOUD_DATA_DIR=.olympus/cloud

# Memória compartilhada. Deixe vazio para SQLite local; em cloud, use uma
# URL PostgreSQL protegida (a senha nunca deve entrar no código ou no frontend).
# OLYMPUS_MEMORY_DATABASE_URL=postgresql://usuario:senha@host:5432/olympus
OLYMPUS_MEMORY_DB=olympus_memory.db

# Modelos gratuitos podem aguardar capacidade no provedor. O backend é
# assíncrono, portanto este orçamento não bloqueia a interface.
OLYMPUS_MODEL_TIMEOUT=30
# O teste real de conexão também precisa tolerar a fila de modelos gratuitos.
OLYMPUS_PROVIDER_TEST_TIMEOUT=60

# Fallback inicial entre provedores independentes. Outros provedores podem ser
# incluídos explicitamente pela Central de IAs; fontes potencialmente pagas
# exigem confirmação visual e seguem os limites da conta do usuário.
# Crie as chaves nos painéis oficiais dos provedores e nunca as compartilhe.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
CLOUDFLARE_API_KEY=
OLYMPUS_CLOUDFLARE_URL=
KIMI_API_KEY=
OPENCODE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# API oficial de mídia; nunca habilitada no fallback textual gratuito.
OLYMPUS_HIGGSFIELD_URL=https://api.higgsfield.ai
OLYMPUS_HIGGSFIELD_TIMEOUT=60
OLYMPUS_FREE_FALLBACK_PROVIDERS=fcc,groq,openrouter,ollama,opencode_zen
# Gateway OpenCode Zen. Modelos terminados em -free entram no fluxo gratuito;
# modelos pagos só entram com autorização explícita e teto de gasto.
OLYMPUS_OPENCODE_ZEN_URL=https://opencode.ai/zen/v1
# Together e Fireworks são opt-in e podem consumir créditos conforme o plano.
OLYMPUS_TOGETHER_URL=https://api.together.ai/v1
OLYMPUS_FIREWORKS_URL=https://api.fireworks.ai/inference/v1
# Ollama local ou remoto compatível com OpenAI. O padrão é a porta local.
# OLYMPUS_OLLAMA_URL=http://127.0.0.1:11434/v1
# Ponte opcional para o Free Claude Code. O launcher inicia o FCC quando ele
# já estiver instalado; nenhuma instalação externa ocorre silenciosamente.
OLYMPUS_FCC_URL=http://127.0.0.1:8082/v1
FCC_PROXY_TOKEN=
# Use uma lista exata se o catálogo FCC não identificar claramente as rotas gratuitas.
# OLYMPUS_FCC_FREE_MODELS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b,open_router/openrouter/free
# OLYMPUS_START_FCC=1
# OLYMPUS_ENABLE_METERED_PROVIDERS=false
# OLYMPUS_GROQ_MODELS=qwen/qwen3.8-27b,qwen/qwen3.6-27b,openai/gpt-oss-20b
# OLYMPUS_CEREBRAS_MODELS=qwen-3.8-27b,gpt-oss-120b
# OLYMPUS_ZAI_MODELS=glm-4.7-flash,glm-4.5-flash
# Cloudflare exige a URL da conta, por exemplo:
# OLYMPUS_CLOUDFLARE_URL=https://api.cloudflare.com/client/v4/accounts/SEU_ID/ai/v1

# Em produção, use um adaptador KMS/Secret Manager no formato módulo:factory.
# OLYMPUS_KMS_PROVIDER=my_company.kms:create_provider

# Persistência de acesso do Runner exige chave estável entregue pelo cofre.
# OLYMPUS_RUNNER_SIGNING_KEY=
# OLYMPUS_RUNNER_RELEASE_DIR=
# OLYMPUS_RUNNER_RELEASE_PUBLIC_KEY=
